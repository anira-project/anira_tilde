{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "desktop-release",
            "displayName": "Desktop Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/desktop/Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANIRA_TILDE_WITH_TESTS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "desktop-debug",
            "displayName": "Desktop Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/desktop/Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ANIRA_TILDE_WITH_TESTS": "ON",
                "C74_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/desktop/Debug/externals"
            }
        },
        {
            "name": "macos-x64-release",
            "displayName": "macOS x86_64 Release",
            "inherits": "desktop-release",
            "binaryDir": "${sourceDir}/build/macos-x64/Release",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64",
                "ANIRA_TILDE_TEST_MAX_INFERENCE_TIME_OVERHEAD": "500"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release",
            "binaryDir": "${sourceDir}/build/windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANIRA_TILDE_WITH_TESTS": "ON",
                "ANIRA_TILDE_TEST_MAX_INFERENCE_TIME_OVERHEAD": "500"
            }
        },
        {
            "name": "desktop-debug-asan",
            "displayName": "Desktop Debug + ASan/UBSan",
            "inherits": "desktop-debug",
            "binaryDir": "${sourceDir}/build/desktop/Debug-asan",
            "cacheVariables": {
                "ANIRA_TILDE_WITH_ASAN": "ON",
                "ANIRA_TILDE_WITH_UBSAN": "ON",
                "ANIRA_TILDE_TEST_MAX_INFERENCE_TIME_OVERHEAD": "500",
                "C74_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/desktop/Debug-asan/externals"
            }
        },
        {
            "name": "desktop-debug-tsan",
            "displayName": "Desktop Debug + TSan",
            "inherits": "desktop-debug",
            "binaryDir": "${sourceDir}/build/desktop/Debug-tsan",
            "cacheVariables": {
                "ANIRA_TILDE_WITH_TSAN": "ON",
                "ANIRA_TILDE_TEST_MAX_INFERENCE_TIME_OVERHEAD": "500",
                "C74_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/desktop/Debug-tsan/externals"
            }
        },
        {
            "name": "desktop-debug-rtsan",
            "displayName": "Desktop Debug + RTSan",
            "inherits": "desktop-debug",
            "binaryDir": "${sourceDir}/build/desktop/Debug-rtsan",
            "cacheVariables": {
                "ANIRA_TILDE_WITH_RTSAN": "ON",
                "ANIRA_WITH_RTSAN": "ON",
                "ANIRA_WITH_LOGGING": "OFF",
                "ANIRA_TILDE_TEST_MAX_INFERENCE_TIME_OVERHEAD": "500",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "C74_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/desktop/Debug-rtsan/externals"
            }
        }
    ],
    "buildPresets": [
        { "name": "desktop-release",    "configurePreset": "desktop-release" },
        { "name": "desktop-debug",      "configurePreset": "desktop-debug" },
        { "name": "macos-x64-release",  "configurePreset": "macos-x64-release" },
        { "name": "windows-release",    "configurePreset": "windows-release", "configuration": "Release" },
        { "name": "desktop-debug-asan", "configurePreset": "desktop-debug-asan" },
        { "name": "desktop-debug-tsan", "configurePreset": "desktop-debug-tsan" },
        { "name": "desktop-debug-rtsan","configurePreset": "desktop-debug-rtsan" }
    ],
    "testPresets": [
        {
            "name": "desktop-release",
            "configurePreset": "desktop-release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "desktop-debug",
            "configurePreset": "desktop-debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "macos-x64-release",
            "configurePreset": "macos-x64-release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "desktop-debug-asan",
            "configurePreset": "desktop-debug-asan",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "desktop-debug-tsan",
            "configurePreset": "desktop-debug-tsan",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "desktop-debug-rtsan",
            "configurePreset": "desktop-debug-rtsan",
            "output": { "outputOnFailure": true }
        }
    ]
}
