{
  "inference_config": {
    "model_data": [
      { "model_path": "@MODELS_DIR@/upsample_multistate.pt", "inference_backend": "LIBTORCH" }
    ],
    "tensor_shape": [
      {
        "input_shape":  [[1, 1, 1], [1, 4], [1, 4]],
        "output_shape": [[1, 1, 16], [1, 4], [1, 4]]
      }
    ],
    "processing_spec": {
      "preprocess_input_channels":   [1, 1, 1],
      "postprocess_output_channels": [1, 1, 1],
      "preprocess_input_size":       [1, 0, 0],
      "postprocess_output_size":     [16, 0, 0]
    },
    "max_inference_time": @upsample_multistate_test_max_inference_time@
  },
  "state_config": {
    "state_pairs": [
      { "output_tensor": 1, "input_tensor": 1 },
      { "output_tensor": 2, "input_tensor": 2 }
    ]
  }
}
