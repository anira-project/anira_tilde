{
    "inference_config": {
        "model_data": [
            { "model_path": "@MODELS_DIR@/sine_oscillator.pt", "inference_backend": "LIBTORCH" }
        ],
        "tensor_shape": [
            {
                "input_shape":  [[1, 1, 512], [1, 1]],
                "output_shape": [[1, 1, 512], [1, 1]]
            }
        ],
        "processing_spec": {
            "preprocess_input_channels":   [1, 1],
            "postprocess_output_channels": [1, 1],
            "preprocess_input_size":       [512, 0],
            "postprocess_output_size":     [512, 0]
        },
        "max_inference_time": @sine_oscillator_test_max_inference_time@
    },
    "state_config": {
        "state_pairs": [
            { "output_tensor": 1, "input_tensor": 1 }
        ]
    }
}
